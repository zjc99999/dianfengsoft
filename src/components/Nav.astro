---
/**
 * 主导航（企业门户 ≤6 项）+ 站点品牌。全站共用，currentPath 用来标 aria-current。
 *
 * 品牌链接刻意放在 <nav aria-label="主导航"> 之外：e2e 断言该导航内链接 ≤6，
 * 品牌若放进 nav 会占掉一个名额。当前页用 aria-current="page" 标注（a11y），
 * 强调色下划线由 .nav-link[aria-current] 在 global.css 里提供（纯 CSS）。
 */
import { NAV, SITE } from '../lib/constants';

interface Props {
  currentPath?: string;
}
const { currentPath = '' } = Astro.props;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" target="_blank" rel="noopener noreferrer">
      <img class="brand-logo" src="/images/logo/dianfeng-mark.png" width="34" height="34" alt="" aria-hidden="true" />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="主导航" class="main-nav">
      {
        NAV.map((item) => {
          const active =
            currentPath === item.href ||
            (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class="nav-link"
             target="_blank" rel="noopener noreferrer">
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <!-- 全站搜索：刻意放在 <nav> 外，不占主导航 ≤6 的预算（e2e 只数 nav 内链接） -->
    <a href="/search" class="nav-search" aria-label="全站搜索" target="_blank" rel="noopener noreferrer">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span>搜索</span>
    </a>
    <!-- 深浅色切换：图标按钮，同样在 <nav> 外；图标显隐由 /theme.js 写入的 data-theme 经 CSS 控制。
         默认深色时显示月亮、浅色时显示太阳（对齐焕名）；点击切换到另一主题并记忆到 localStorage。 -->
    <button id="themeToggle" class="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="12" y1="2.5" x2="12" y2="5" />
          <line x1="12" y1="19" x2="12" y2="21.5" />
          <line x1="2.5" y1="12" x2="5" y2="12" />
          <line x1="19" y1="12" x2="21.5" y2="12" />
          <line x1="5.2" y1="5.2" x2="6.9" y2="6.9" />
          <line x1="17.1" y1="17.1" x2="18.8" y2="18.8" />
          <line x1="18.8" y1="5.2" x2="17.1" y2="6.9" />
          <line x1="6.9" y1="17.1" x2="5.2" y2="18.8" />
        </g>
      </svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M20 13.5A8 8 0 1 1 10.5 4a6.3 6.3 0 0 0 9.5 9.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</header>
